# ESCANOR environment — copy to .env (gitignored) and adjust.
# Loaded by data/paths.py via python-dotenv at import time.

# Relational store for metering observations and retraining decisions.
# Leave unset for the default file-backed SQLite database at results/escanor.db,
# which needs no infrastructure. Point it at PostgreSQL for a server deployment:
#
# DATABASE_URL=postgresql+psycopg://escanor:escanor@localhost:5432/escanor
#
# DATABASE_URL=

# API key required on the write endpoints (X-API-Key header).
# ESCANOR_API_KEY=dev-key

# Artifact and project roots, if the defaults are not wanted.
# PRESOL_RESULTS_DIR=
# PRESOL_ROOT=
